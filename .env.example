NODE_ENV=development
HOST=127.0.0.1
PORT=5004
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-host>/velakron
MONGO_DB_NAME=velakron

VELAKRON_JOBS_ENABLED=false
VELAKRON_SCHEDULED_JOBS_ENABLED=false
VELAKRON_ATTENTION_WRITES_ENABLED=false
VELAKRON_MAINTENANCE_WRITES_ENABLED=false
VELAKRON_WORKER_INSTANCE_ID=local-worker
VELAKRON_OUTBOX_POLL_MS=5000
VELAKRON_JOB_LEASE_MS=60000
VELAKRON_JOB_MAX_ATTEMPTS=8
VELAKRON_ATTENTION_INTERVAL_MS=900000
VELAKRON_ATTACHMENT_MAINTENANCE_INTERVAL_MS=3600000
VELAKRON_TOKEN_CLEANUP_INTERVAL_MS=21600000

VELAKRON_EMAIL_ADAPTER=development
VELAKRON_EMAIL_DELIVERY_ENABLED=false
VELAKRON_OUTBOX_ENCRYPTION_KEY=<base64-encoded-random-key>
VELAKRON_EMAIL_ALLOWED_RECIPIENTS=<comma-separated-development-recipients>
VELAKRON_GMAIL_CLIENT_ID=<google-oauth-client-id>
VELAKRON_GMAIL_CLIENT_SECRET=<google-oauth-client-secret>
VELAKRON_GMAIL_CREDENTIALS_FILE=
VELAKRON_GMAIL_TOKEN_FILE=.gmail-token.json
VELAKRON_GMAIL_AUTHORIZED_MAILBOX=plara@velakron.com
VELAKRON_GMAIL_SENDER=app@velakron.com
VELAKRON_GMAIL_FROM_NAME=Velakron
VELAKRON_GMAIL_REPLY_TO=app@velakron.com
VELAKRON_GMAIL_OAUTH_REDIRECT_URI=http://127.0.0.1:5010/oauth2/callback

VELAKRON_MALWARE_SCANNER_ADAPTER=disabled
VELAKRON_MALWARE_SCANNING_ENABLED=false
VELAKRON_AWS_ACCOUNT_ID=<12-digit-aws-account-id>
VELAKRON_AWS_REGION=<aws-region>
VELAKRON_S3_BUCKET=<private-bucket-name>
VELAKRON_AWS_ACCESS_KEY_ID=<bucket-scoped-access-key-id>
VELAKRON_AWS_SECRET_ACCESS_KEY=<bucket-scoped-secret-access-key>
VELAKRON_AWS_SESSION_TOKEN=
VELAKRON_GUARDDUTY_SCAN_TAG_KEY=GuardDutyMalwareScanStatus
